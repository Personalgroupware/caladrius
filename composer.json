{
	"name": "personalgroupware/caladrius",
	"type": "phpbb-extension",
	"description": "A plain-English health page for your board: scheduled jobs, the email queue, database growth, support dates, and a tampering check of phpBB's own files. It only reads, and it sends nothing anywhere.",
	"homepage": "https://www.personalgroupware.com/caladrius/",
	"version": "0.1.9-dev",
	"time": "2026-11-20",
	"license": "GPL-2.0-only",
	"authors": [
		{
			"name": "Wilson Logan",
			"homepage": "https://www.personalgroupware.com/",
			"role": "Developer"
		}
	],
	"require": {
		"php": ">=7.2.0",
		"composer/installers": "~1.0"
	},
	"extra": {
		"display-name": "Caladrius",
		"version-check": {
			"host": "www.personalgroupware.com",
			"directory": "/caladrius",
			"filename": "version.json",
			"ssl": true
		},
		"soft-require": {
			"phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
		}
	}
}
